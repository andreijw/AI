{
  "extraKnownMarketplaces": {
    "brooks-lint-marketplace": {
      "source": {
        "source": "github",
        "repo": "hyhmrright/brooks-lint",
        "ref": "v1.7.0"
      }
    }
  },
  "enabledPlugins": {
    "brooks-lint@brooks-lint-marketplace": true
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m ruff check *)",
      "Bash(.venv/bin/python -m ruff format --check *)",
      "Bash(.venv/bin/python -m mypy src)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -m bandit -r src/ -ll)",
      "Bash(.venv/bin/python -m pylint src --disable=all --enable=duplicate-code *)",
      "Bash(.venv/bin/python .claude/skills/test-crafter/scripts/mutation_check.py *)",
      "Bash(.venv/bin/python .claude/skills/doc-sync/scripts/check_md_width.py *)",
      "Bash(.venv/Scripts/python -m ruff check *)",
      "Bash(.venv/Scripts/python -m ruff format --check *)",
      "Bash(.venv/Scripts/python -m mypy src)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(.venv/Scripts/python -m bandit -r src/ -ll)",
      "Bash(.venv/Scripts/python -m pylint src --disable=all --enable=duplicate-code *)",
      "Bash(.venv/Scripts/python .claude/skills/test-crafter/scripts/mutation_check.py *)",
      "Bash(.venv/Scripts/python .claude/skills/doc-sync/scripts/check_md_width.py *)"
    ]
  }
}
