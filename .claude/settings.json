{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python *)",
      "Bash(.venv/Scripts/python *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Edit(/.claude/skills/**)",
      "Bash(gh run *)"
    ]
  },
  "enabledPlugins": {
    "brooks-lint@brooks-lint-marketplace": true
  },
  "extraKnownMarketplaces": {
    "brooks-lint-marketplace": {
      "source": {
        "source": "github",
        "repo": "hyhmrright/brooks-lint",
        "ref": "v1.7.0"
      }
    }
  }
}
