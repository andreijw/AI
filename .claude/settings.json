{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python *)",
      "Bash(.venv/Scripts/python *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Edit(/.claude/skills/**)",
      "Bash(gh *)",
      "Bash(sort *)",
      "Edit(/.claude/skills/test-crafter/**)",
      "Bash(git grep *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh stack merge *)",
      "Bash(gh stack rebase *)",
      "Bash(gh stack sync *)",
      "Bash(gh repo delete *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm --recursive *)"
    ]
  },
  "enabledPlugins": {
    "brooks-lint@brooks-lint-marketplace": true
  },
  "extraKnownMarketplaces": {
    "brooks-lint-marketplace": {
      "source": {
        "source": "github",
        "repo": "hyhmrright/brooks-lint",
        "ref": "v1.7.0"
      }
    }
  }
}
